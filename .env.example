POSTGRES_DB=huquqchi
POSTGRES_USER=huquqchi
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_ISSUER=huquqchi
JWT_AUDIENCE=huquqchi-mobile
JWT_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
OTP_HASH_KEY=replace-with-at-least-32-random-characters
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_URL=https://t.me/replace_with_bot_username
API_PORT=8080
HUQUQCHI_IMAGE=ghcr.io/istamovmirjahon/huquqchi:latest
HUQUQCHI_BOT_IMAGE=ghcr.io/istamovmirjahon/huquqchi-bot:latest
# Public API address used in signed file download links
FILES_PUBLIC_BASE_URL=https://api.huquqchi.uz
# Optional: dedicated key for signed file links (at least 32 characters); derived from JWT_KEY when empty
FILES_SIGNING_KEY=
# Optional: ClamAV daemon; when empty, uploads are stored with scan status "Skipped"
CLAMAV_HOST=
CLAMAV_PORT=3310
CORS_ALLOWED_ORIGIN=https://app.huquqchi.uz
# Set to true only when the API runs behind a trusted reverse proxy
FORWARDED_HEADERS_ENABLED=false
