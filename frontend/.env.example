# Rejim: mock (backendsiz demo) | hybrid (tayyor endpointlar backendda, qolgani mock) | real (hammasi backendda)
VITE_API_MODE=mock
# Backend manzili. Bo'sh qoldirilsa so'rovlar shu domenning o'ziga ketadi (dev'da VITE_API_PROXY orqali).
VITE_API_URL=
# Faqat dev server uchun: /api so'rovlarini shu backendga proxy qiladi (CORS muammosini chetlab o'tadi).
VITE_API_PROXY=
